# =============================================================================
# MeetMind v2 — пример .env
# Скопируй в .env и заполни свои значения. Любое поле можно оставить пустым —
# соответствующий компонент просто не будет работать.
# =============================================================================

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Три backend'а. Любой можно включить независимо. Включённые работают
# параллельно. На вход cloud-слота приоритетнее USE_CLAUDE_CODE (Max-подписка),
# на запасном пути — Anthropic API.
#
# Рекомендуемая конфигурация при наличии Max:
#   USE_OLLAMA=true + USE_CLAUDE_CODE=true + USE_ANTHROPIC=false

# ─── #1: Ollama (локально, бесплатно, оффлайн) ───────────────────────────────
USE_OLLAMA=true
OLLAMA_URL=http://localhost:11434
#
# Какую модель ставить? Я ресёрчил под твой M5 Pro 24GB + русский + встречи.
# По дефолту GPU получает ~16GB, Whisper ест ~3GB → на LLM ~12-13GB.
#
# 🥇 Vikhr-Nemo-12B-Instruct — русский тюн поверх Mistral Nemo, 128K контекст,
#    7.5GB в Q4. Лучший баланс «русский + длинные встречи + comfort».
#    OLLAMA_MODEL=vikhr-nemo:12b-instruct-q4
#
# 🥈 Qwen3.5-14B-Instruct — свежайший Alibaba (Feb 2026), 201 язык, 9GB в Q4.
#    OLLAMA_MODEL=qwen3.5:14b
#
# 🥉 T-pro 2.0 (32B) — премиум русский от T-Bank, но требует sysctl tweak.
#    OLLAMA_MODEL=t-tech/t-pro-it-2.0:Q4_K_M
OLLAMA_MODEL=vikhr-nemo:12b-instruct-q4

# ─── #2: Claude Code CLI (через Max-подписку) ────────────────────────────────
# Рекомендуется если у тебя есть Max. Использует существующую авторизацию CLI,
# отдельного API-ключа НЕ нужно. Не списывает с API-кошелька.
#
# Проверь что claude установлен:    which claude
# Если нет:                          npm install -g @anthropic-ai/claude-code
# Авторизация:                       claude login (в обычном CLI режиме)
USE_CLAUDE_CODE=true
CLAUDE_CODE_BINARY=claude
# Алиасы: opus | sonnet | haiku. Для followup'ов рекомендую opus (Opus 4.7).
CLAUDE_CODE_MODEL=opus

# ─── #3: Anthropic API (если нет Max или хочешь параллельно второй cloud) ────
# При включённом USE_CLAUDE_CODE этот канал НЕ используется чтобы не платить
# дважды одному провайдеру за один и тот же ответ.
USE_ANTHROPIC=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Whisper (транскрипция) ──────────────────────────────────────────────────
# tiny / base / small / medium / large / large-v3 / turbo
# large-v3 даёт лучшее качество; turbo чуть хуже но быстрее
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=ru

# ─── Аудио ───────────────────────────────────────────────────────────────────
# Создай Aggregate Device в Audio MIDI Setup: BlackHole 2ch + твой микрофон,
# назови его как ниже (или подставь своё имя). Без Aggregate Device запись
# будет только с BlackHole (системный звук, без твоего голоса).
AGGREGATE_DEVICE_NAME=MeetMind In
BLACKHOLE_DEVICE_NAME=BlackHole 2ch
AUDIO_SAMPLE_RATE=16000

# ─── Telegram (sink #1) ──────────────────────────────────────────────────────
# Чтобы создать бота: @BotFather → /newbot. Свой chat_id: @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Markdown (sink #2) ──────────────────────────────────────────────────────
ENABLE_MARKDOWN_SINK=true
MARKDOWN_BASE_DIR=~/MeetMind

# ─── Obsidian (sink #3) ──────────────────────────────────────────────────────
ENABLE_OBSIDIAN_SINK=false
OBSIDIAN_VAULT_PATH=
OBSIDIAN_SUBFOLDER=Meetings

# ─── Notion (sink #4) ────────────────────────────────────────────────────────
# Создать integration: notion.so/my-integrations → Internal Integration.
# Затем в нужной базе: Share → добавить интеграцию.
ENABLE_NOTION_SINK=false
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ─── Триггеры ────────────────────────────────────────────────────────────────
ENABLE_CALENDAR_TRIGGER=true
ENABLE_PROCESS_TRIGGER=true
ENABLE_MENUBAR=true
HOTKEY_START_STOP=<cmd>+<shift>+r

# Что считать "встречей" для process-watcher (через запятую, lower-case)
MEETING_APP_PROCESSES=zoom.us,zoom
MEETING_URL_PATTERNS=meet.google.com,zoom.us/j/,teams.microsoft.com,whereby.com

# ─── Google Calendar ─────────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_PATH=credentials.json

# ─── Пути и серверы ──────────────────────────────────────────────────────────
SESSIONS_DIR=sessions
WS_PORT=8765
WEB_PORT=8080
LOG_LEVEL=INFO
