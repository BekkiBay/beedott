{
  "manifest_version": 2,
  "name": "MeetMind",
  "version": "1.0.0",
  "description": "Трансляция событий Google Meet в локальный WebSocket сервер",

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications"
  ],

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "MeetMind",
    "default_icon": "icons/icon.svg"
  },

  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}
